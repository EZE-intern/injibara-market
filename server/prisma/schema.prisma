generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model addresses {
  id             Int      @id @default(autoincrement())
  user_id        Int
  full_name      String?  @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  region         String?  @db.VarChar(100)
  city           String?  @db.VarChar(100)
  kebele         String?  @db.VarChar(100)
  street_address String?  @db.Text
  is_default     Boolean? @default(false)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "addresses_ibfk_1")

  @@index([user_id], map: "user_id")
}

model cart_items {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int      @default(1)
  created_at DateTime @default(now()) @db.Timestamp(0)
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_ibfk_1")
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_ibfk_2")

  @@unique([cart_id, product_id], map: "unique_cart_product")
  @@index([product_id], map: "product_id")
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int?         @unique(map: "user_id")
  created_at DateTime     @default(now()) @db.Timestamp(0)
  updated_at DateTime     @default(now()) @db.Timestamp(0)
  cart_items cart_items[]
  users      users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "carts_ibfk_1")
}

model categories {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(100)
  slug           String           @unique(map: "slug") @db.VarChar(100)
  description    String?          @db.Text
  image          String?          @db.VarChar(255)
  created_at     DateTime         @default(now()) @db.Timestamp(0)
  deleted_at     DateTime?        @db.Timestamp(0)
  products       products[]
  sub_categories sub_categories[]
}

model sub_categories {
  id                Int                 @id @default(autoincrement())
  category_id       Int                 @map("category_id")
  name              String              @db.VarChar(100)
  slug              String              @unique @db.VarChar(100)
  description       String?             @db.Text
  image             String?             @db.VarChar(255)
  created_at        DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  deleted_at        DateTime?           @map("deleted_at") @db.Timestamp(0)
  category          categories          @relation(fields: [category_id], references: [id], onDelete: Cascade, map: "sub_categories_ibfk_1")
  subcategory_items subcategory_items[]
  products          products[]

  @@index([category_id], map: "category_id")
}

model subcategory_items {
  id              Int            @id @default(autoincrement())
  sub_category_id Int            @map("sub_category_id")
  name            String
  slug            String         @unique
  description     String?        @db.Text
  image           String?
  created_at      DateTime       @default(now()) @map("created_at")
  updated_at      DateTime       @updatedAt @map("updated_at")
  deleted_at      DateTime?      @map("deleted_at")
  sub_category    sub_categories @relation(fields: [sub_category_id], references: [id], onDelete: Cascade)

  @@index([sub_category_id, deleted_at])
  @@map("sub_category_items")
}

model favorites {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_ibfk_1")
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_ibfk_2")

  @@unique([user_id, product_id], map: "unique_user_favorite")
  @@index([product_id], map: "product_id")
  @@index([user_id], map: "user_id")
}

model inventory_logs {
  id         Int      @id @default(autoincrement())
  product_id Int
  change     Int
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inventory_logs_ibfk_1")

  @@index([product_id], map: "product_id")
}

model messages {
  id                                Int       @id @default(autoincrement())
  sender_id                         Int
  receiver_id                       Int
  product_id                        Int?
  order_id                          Int?
  message_text                      String    @db.Text
  is_read                           Boolean?  @default(false)
  created_at                        DateTime  @default(now()) @db.Timestamp(0)
  users_messages_sender_idTousers   users     @relation("messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_1")
  users_messages_receiver_idTousers users     @relation("messages_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "messages_ibfk_2")
  products                          products? @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "messages_ibfk_3")
  orders                            orders?   @relation(fields: [order_id], references: [id], onUpdate: Restrict, map: "messages_ibfk_4")

  @@index([order_id], map: "order_id")
  @@index([product_id], map: "product_id")
  @@index([receiver_id], map: "receiver_id")
  @@index([sender_id], map: "sender_id")
}

model order_items {
  id           Int       @id @default(autoincrement())
  order_id     Int
  product_id   Int?
  product_name String?   @db.VarChar(200)
  price        Decimal   @db.Decimal(12, 2)
  quantity     Int
  orders       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_items_ibfk_1")
  products     products? @relation(fields: [product_id], references: [id], onUpdate: Restrict, map: "order_items_ibfk_2")

  @@index([order_id], map: "order_id")
  @@index([product_id], map: "product_id")
}

model order_status_history {
  id         Int                         @id @default(autoincrement())
  order_id   Int
  status     order_status_history_status
  changed_by Int?
  changed_at DateTime                    @default(now()) @db.Timestamp(0)
  orders     orders                      @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_status_history_ibfk_1")
  users      users?                      @relation(fields: [changed_by], references: [id], onUpdate: Restrict, map: "order_status_history_ibfk_2")

  @@index([changed_by], map: "changed_by")
  @@index([order_id], map: "order_id")
}

model orders {
  id                   Int                    @id @default(autoincrement())
  user_id              Int
  shipping_address_id  Int?
  order_number         String                 @unique(map: "order_number") @db.VarChar(50)
  total_amount         Decimal                @db.Decimal(12, 2)
  status               orders_status?         @default(pending)
  payment_method       orders_payment_method? @default(cash_on_delivery)
  payment_status       orders_payment_status? @default(pending)
  shipping_address     String?                @db.Text
  note                 String?                @db.Text
  created_at           DateTime               @default(now()) @db.Timestamp(0)
  updated_at           DateTime               @default(now()) @db.Timestamp(0)
  messages             messages[]
  order_items          order_items[]
  order_status_history order_status_history[]
  users                users                  @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "orders_ibfk_1")
  payments             payments[]

  @@index([user_id], map: "user_id")
}

model payments {
  id             Int                     @id @default(autoincrement())
  order_id       Int
  user_id        Int
  transaction_id String?                 @db.VarChar(100)
  payment_method payments_payment_method
  amount         Decimal                 @db.Decimal(12, 2)
  currency       String?                 @default("ETB") @db.VarChar(10)
  status         payments_status?        @default(pending)
  provider       String?                 @db.VarChar(50)
  paid_at        DateTime?               @db.Timestamp(0)
  created_at     DateTime                @default(now()) @db.Timestamp(0)
  orders         orders                  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "payments_ibfk_1")

  @@index([order_id], map: "order_id")
}

model product_images {
  id         Int      @id @default(autoincrement())
  product_id Int
  image_url  String   @db.VarChar(255)
  side_angle String?  @db.VarChar(20)
  is_primary Boolean? @default(false)
  sort_order Int?     @default(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "product_images_ibfk_1")

  @@index([product_id], map: "product_id")
}

model products {
  id              Int              @id @default(autoincrement())
  store_id        Int?
  seller_id       Int?
  category_id     Int?
  sub_category_id Int?
  name            String           @db.VarChar(200)
  slug            String           @db.VarChar(200)
  description     String?          @db.Text
  price           Decimal          @db.Decimal(12, 2)
  discount_price  Decimal?         @db.Decimal(12, 2)
  stock           Int?             @default(0)
  status          products_status? @default(draft)
  image           String?          @db.VarChar(255)
  images          String?          @db.LongText
  is_active       Boolean?         @default(true)
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime         @default(now()) @db.Timestamp(0)
  deleted_at      DateTime?        @db.Timestamp(0)
  cart_items      cart_items[]
  favorites       favorites[]
  inventory_logs  inventory_logs[]
  messages        messages[]
  order_items     order_items[]
  product_images  product_images[]
  users           users?           @relation(fields: [seller_id], references: [id], onUpdate: Restrict, map: "products_ibfk_1")
  categories      categories?      @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "products_ibfk_2")
  sub_categories  sub_categories?  @relation(fields: [sub_category_id], references: [id], onUpdate: Restrict)
  stores          stores?          @relation(fields: [store_id], references: [id], onDelete: SetNull)
  reviews         reviews[]

  @@index([category_id], map: "category_id")
  @@index([sub_category_id])
  @@index([seller_id], map: "seller_id")
  @@index([store_id])
}

model reviews {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    Int
  rating     Int?     @db.TinyInt
  comment    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reviews_ibfk_1")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reviews_ibfk_2")

  @@unique([product_id, user_id], map: "unique_user_product_review")
  @@index([user_id], map: "user_id")
}

model stores {
  id          Int        @id @default(autoincrement())
  seller_id   Int
  store_name  String     @db.VarChar(150)
  slug        String     @unique(map: "slug") @db.VarChar(150)
  logo        String?    @db.VarChar(255)
  description String?    @db.Text
  phone       String?    @db.VarChar(20)
  address     String?    @db.Text
  is_active   Boolean?   @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(0)
  updated_at  DateTime   @default(now()) @db.Timestamp(0)
  deleted_at  DateTime?  @db.Timestamp(0)
  users       users      @relation(fields: [seller_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "stores_ibfk_1")
  products    products[]

  @@index([seller_id], map: "seller_id")
}

model users {
  id                                   Int                    @id @default(autoincrement())
  full_name                            String                 @db.VarChar(100)
  email                                String                 @unique(map: "email") @db.VarChar(100)
  phone                                String?                @unique(map: "phone") @db.VarChar(20)
  password                             String                 @db.VarChar(255)
  role                                 users_role?            @default(customer)
  created_at                           DateTime               @default(now()) @db.Timestamp(0)
  updated_at                           DateTime               @default(now()) @db.Timestamp(0)
  deleted_at                           DateTime?              @db.Timestamp(0)
  addresses                            addresses[]
  carts                                carts?
  favorites                            favorites[]
  messages_messages_sender_idTousers   messages[]             @relation("messages_sender_idTousers")
  messages_messages_receiver_idTousers messages[]             @relation("messages_receiver_idTousers")
  order_status_history                 order_status_history[]
  orders                               orders[]
  products                             products[]
  reviews                              reviews[]
  stores                               stores[]
}

enum order_status_history_status {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum payments_payment_method {
  telebirr
  cbe_birr
  bank_transfer
  cash_on_delivery
}

enum orders_status {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
}

enum users_role {
  customer
  admin
  seller
}

enum orders_payment_method {
  telebirr
  cbe_birr
  bank_transfer
  cash_on_delivery
}

enum orders_payment_status {
  pending
  paid
  failed
}

enum payments_status {
  pending
  successful
  failed
  refunded
}

enum products_status {
  draft
  pending
  approved
  rejected
  inactive
  archived
}
